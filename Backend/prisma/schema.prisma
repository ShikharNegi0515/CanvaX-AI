// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  password       String?  // Optional for OAuth users
  googleId       String?  @unique
  githubId       String?  @unique
  avatarUrl      String?
  canvases       Canvas[] @relation("OwnedCanvases")
  collaborations CanvasCollaborator[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Canvas {
  id            String   @id @default(uuid())
  name          String   @default("Untitled Canvas")
  data          Json     @default("[]")
  thumbnail     String?  // base64 PNG data URL captured from canvas
  userId        String
  user          User     @relation("OwnedCanvases", fields: [userId], references: [id], onDelete: Cascade)
  collaborators CanvasCollaborator[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  EDITOR
  VIEWER
}

model CanvasCollaborator {
  id       String @id @default(uuid())
  canvasId String
  userId   String
  role     Role   @default(VIEWER)

  canvas   Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([canvasId, userId])
}

